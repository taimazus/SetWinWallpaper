<Window x:Class="BingWallpaperPro.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سهند نما • ویجت شیشه‌ای دسکتاپ" SizeToContent="Height" Width="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FlowDirection="RightToLeft" Topmost="False"
        FontFamily="pack://application:,,,/BingWallpaperPro;component/Assets/Fonts/#Vazirmatn"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">
 <Window.Resources>
  <FontFamily x:Key="VazirmatnFont">pack://application:,,,/BingWallpaperPro;component/Assets/Fonts/#Vazirmatn</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource VazirmatnFont}"/><Setter Property="Foreground" Value="#EAF2F7"/></Style>
  
  <!-- General Widget Action Buttons Style -->
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource VazirmatnFont}"/>
   <Setter Property="Background" Value="#151A354A"/>
   <Setter Property="Foreground" Value="#C4E2F2"/>
   <Setter Property="BorderBrush" Value="#25386785"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,4"/>
   <Setter Property="Margin" Value="2,0"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Opacity" Value="0.45"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="BtnBorder" Property="Background" Value="#66255173"/>
        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#885CE8CE"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="BtnBorder" Property="Background" Value="#550E202E"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Opacity" Value="1.0"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter Property="Opacity" Value="1.0"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- Dedicated Ghost Header Buttons Style (Super transparent at idle, crystal clear on hover) -->
  <Style x:Key="HeaderIconButton" TargetType="Button">
   <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe MDL2 Assets, Segoe UI, Vazirmatn"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#B2D4E8"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Opacity" Value="0.22"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="BtnSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="BtnSurface" Property="Background" Value="#55224D6E"/>
        <Setter TargetName="BtnSurface" Property="BorderBrush" Value="#885CE8CE"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="BtnSurface" Property="Background" Value="#66102D42"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Opacity" Value="1.0"/>
     <Setter Property="Foreground" Value="#FFFFFF"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Setter Property="Opacity" Value="1.0"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- Dark ContextMenu & Submenu Styles -->
  <Style TargetType="{x:Type ContextMenu}">
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="OverridesDefaultStyle" Value="True"/>
   <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
   <Setter Property="HasDropShadow" Value="True"/>
   <Setter Property="Background" Value="#122332"/>
   <Setter Property="Foreground" Value="#EDF6F9"/>
   <Setter Property="BorderBrush" Value="#2D536F"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontFamily" Value="{StaticResource VazirmatnFont}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ContextMenu}">
      <Border Background="#122332" BorderBrush="#2D536F" BorderThickness="1" CornerRadius="12" Padding="6">
       <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.75"/>
       </Border.Effect>
       <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="{x:Type Separator}">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type Separator}">
      <Border Height="1" Background="#264157" Margin="4,4"/>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="{x:Type MenuItem}">
   <Setter Property="Foreground" Value="#EDF6F9"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontFamily" Value="{StaticResource VazirmatnFont}"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type MenuItem}">
      <Grid>
       <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>

         <!-- Checkmark -->
         <TextBlock x:Name="CheckGlyph" Text="✓" Foreground="#5BE5C9" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

         <!-- Header -->
         <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,10,0"/>

         <!-- Submenu Arrow -->
         <TextBlock x:Name="SubmenuArrow" Grid.Column="2" Text="◀" FontSize="10" Foreground="#8FAABC" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed" Margin="4,0,2,0"/>
        </Grid>
       </Border>

       <!-- Submenu Popup with dark styling -->
       <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Left" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" PopupAnimation="Fade">
        <Border Background="#122332" BorderBrush="#2D536F" BorderThickness="1" CornerRadius="12" Padding="6" Margin="4">
         <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.75"/>
         </Border.Effect>
         <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
       </Popup>
      </Grid>

      <ControlTemplate.Triggers>
       <Trigger Property="HasItems" Value="True">
        <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="ItemBorder" Property="Background" Value="#224842"/>
        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4FBFA8"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter TargetName="SubmenuArrow" Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <!-- Right-Click Context Menu -->
 <Window.ContextMenu>
  <ContextMenu FlowDirection="RightToLeft">
   <MenuItem Header="📌 نحوه قرارگیری ویجت" FontWeight="Bold">
    <MenuItem x:Name="MenuPinDesktop" Header="🪟 چسبیده به پس‌زمینه دسکتاپ (والپیپر)" Click="MenuPinDesktop_Click"/>
    <MenuItem x:Name="MenuPinNormal" Header="🔲 پنجره عادی" Click="MenuPinNormal_Click"/>
    <MenuItem x:Name="MenuPinTopMost" Header="📌 همیشه روی همه پنجره‌ها (TopMost)" Click="MenuPinTopMost_Click"/>
   </MenuItem>
   <Separator/>
   <MenuItem x:Name="MenuToggleWeather" Header="🌤️ نمایش اطلاعات آب و هوا" IsCheckable="True" Click="MenuToggleWeather_Click"/>
   <MenuItem x:Name="MenuToggleHardware" Header="💻 نمایش وضعیت سخت‌افزار (CPU/RAM)" IsCheckable="True" Click="MenuToggleHardware_Click"/>
   <MenuItem x:Name="MenuToggleClock" Header="🕒 نمایش ساعت و تقویم شمسی" IsCheckable="True" Click="MenuToggleClock_Click"/>
   <MenuItem x:Name="MenuToggleWallpaper" Header="🖼️ نمایش اطلاعات تصویر والپیپر" IsCheckable="True" Click="MenuToggleWallpaper_Click"/>
   <MenuItem x:Name="MenuToggleActions" Header="⚡ نمایش دکمه‌های کنترل سریع" IsCheckable="True" Click="MenuToggleActions_Click"/>
   <Separator/>
   <MenuItem Header="🎨 میزان شفافیت پس‌زمینه (Opacity)">
    <MenuItem Header="۱۰۰٪ (کاملاً مات)" Click="MenuOpacity_Click" Tag="1.0"/>
    <MenuItem Header="۸۵٪ (مات متعادل)" Click="MenuOpacity_Click" Tag="0.85"/>
    <MenuItem Header="۷۰٪ (شیشه‌ای ملایم)" Click="MenuOpacity_Click" Tag="0.70"/>
    <MenuItem Header="۵۰٪ (شفاف شیشه‌ای)" Click="MenuOpacity_Click" Tag="0.50"/>
    <MenuItem Header="۳۰٪ (بسیار شفاف)" Click="MenuOpacity_Click" Tag="0.30"/>
   </MenuItem>
   <Separator/>
   <MenuItem Header="⚙️ تنظیمات پیشرفته در سهند نما…" Click="OpenApp_Click"/>
   <MenuItem Header="✕ پنهان‌سازی ویجت" Click="CloseBtn_Click"/>
  </ContextMenu>
 </Window.ContextMenu>

 <!-- Frosted Glass Container -->
 <Border x:Name="GlassRootBorder" Background="#4D0B1A28" BorderBrush="#664D7B99" BorderThickness="1.2" CornerRadius="20" Padding="14" Margin="6">
  <Border.Effect>
   <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
  </Border.Effect>
  <StackPanel Orientation="Vertical">

   <!-- 1. Header: Clock, Date & Widget Mode Controls -->
   <Grid x:Name="ClockPanel" Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Orientation="Vertical">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI, Tahoma"/>
      <Border Background="#3318856F" BorderBrush="#5551D6B8" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock x:Name="GregorianDateText" Text="02 Oct 2026" FontSize="10" Foreground="#8CE9D4" FontFamily="Segoe UI"/>
      </Border>
     </StackPanel>
     <TextBlock x:Name="PersianDateText" Text="در حال بارگذاری تقویم خورشیدی…" FontSize="11" Foreground="#A9D4EB" Margin="0,2,0,0"/>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
     <Button x:Name="PinModeBtn" Style="{StaticResource HeaderIconButton}" Content="🪟" Click="PinModeBtn_Click" ToolTip="تغییر نحوه قرارگیری: چسبیده به دسکتاپ / پنجره عادی / همیشه رو" Margin="0,0,4,0"/>
     <Button Style="{StaticResource HeaderIconButton}" Content="⚙" Click="OpenApp_Click" ToolTip="تنظیمات ویجت و برنامه" Margin="0,0,4,0"/>
     <Button Style="{StaticResource HeaderIconButton}" Content="✕" Click="CloseBtn_Click" ToolTip="پنهان‌سازی ویجت"/>
    </StackPanel>
   </Grid>

   <!-- 2. Live Weather & System Info Chips Row -->
   <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Weather Chip -->
    <Border x:Name="WeatherChip" Grid.Column="0" Background="#26002033" BorderBrush="#334A80A3" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="WeatherChip_MouseLeftButtonDown">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="WeatherIconText" Text="🌤️" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
      <StackPanel VerticalAlignment="Center">
       <TextBlock x:Name="WeatherCityAndTemp" Text="تهران • 22°C" FontSize="11" FontWeight="SemiBold" Foreground="#A6EBF8" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="WeatherConditionText" Text="صاف و آفتابی" FontSize="9" Foreground="#8BB7CE" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </StackPanel>
    </Border>

    <!-- Hardware Monitor Chip -->
    <Border x:Name="HardwareChip" Grid.Column="1" Background="#26002033" BorderBrush="#334A80A3" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="4,0,0,0">
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="CpuText" Text="CPU: 12%" FontSize="10" FontWeight="SemiBold" Foreground="#F5D061" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="RamAndBatteryText" Text="RAM: 42% (6.8/16 GB)" FontSize="9" Foreground="#95CBE8" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </Border>
   </Grid>

   <!-- 3. Active Wallpaper Info Card -->
   <Border x:Name="WallpaperPanel" Background="#26000000" BorderBrush="#33406B87" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <Border Width="36" Height="36" CornerRadius="8" Background="#3315354D" BorderBrush="#55396B8A" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
      <Image Source="Assets/SahandNama.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="WallpaperTitleText" Text="سهند نما • والپیپر فعال روز" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
      <TextBlock x:Name="WallpaperCreditText" Text="منظره هوشمند ویندوز" FontSize="10" Foreground="#8FB7CC" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- 4. Footer: Quick Action Controls -->
   <Grid x:Name="QuickActionsPanel">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="تصویر بعدی 🎲" Click="NextWallpaper_Click" ToolTip="دریافت و اعمال تصویر بعدی (Win+Alt+W)"/>
     <Button x:Name="FavoriteBtn" Content="علاقه‌مندی ❤️" Click="Favorite_Click" ToolTip="افزودن به علاقه‌مندی‌ها (Win+Alt+S)"/>
     <Button Content="رنگ تم 🎨" Click="SyncAccent_Click" ToolTip="هماهنگ‌سازی رنگ تم ویندوز با والپیپر"/>
     <Button Content="سهند نما ⚙" Click="OpenApp_Click" ToolTip="باز کردن پنجره اصلی برنامه"/>
    </StackPanel>
   </Grid>

  </StackPanel>
 </Border>
</Window>
