<Window x:Class="BingWallpaperPro.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سهند نما ویجت دسکتاپ" Height="175" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FlowDirection="RightToLeft"
        FontFamily="pack://application:,,,/BingWallpaperPro;component/Assets/Fonts/#Vazirmatn"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged">
 <Window.Resources>
  <FontFamily x:Key="VazirmatnFont">pack://application:,,,/BingWallpaperPro;component/Assets/Fonts/#Vazirmatn</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource VazirmatnFont}"/><Setter Property="Foreground" Value="#EAF2F7"/></Style>
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource VazirmatnFont}"/>
   <Setter Property="Background" Value="#172F3F"/>
   <Setter Property="Foreground" Value="#E2EEF5"/>
   <Setter Property="BorderBrush" Value="#2F556E"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="Margin" Value="3,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1F4760"/><Setter Property="BorderBrush" Value="#4FBFA8"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#0F222F"/></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>

 <Border Background="#E60A1622" BorderBrush="#2C4E65" BorderThickness="1.5" CornerRadius="18" Padding="16">
  <Border.Effect>
   <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.55"/>
  </Border.Effect>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <!-- Header with Clock & Date -->
   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Orientation="Vertical">
     <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI, Tahoma"/>
     <TextBlock x:Name="PersianDateText" Text="در حال بارگذاری…" FontSize="11" Foreground="#9AC4D9" Margin="0,2,0,0"/>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
     <Button x:Name="CloseBtn" Content="✕" Width="26" Height="26" Padding="0" Click="CloseBtn_Click" ToolTip="بستن ویجت"/>
    </StackPanel>
   </Grid>

   <!-- Wallpaper Info Middle Section -->
   <Grid Grid.Row="1" Margin="0,10,0,8">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Width="34" Height="34" CornerRadius="8" Background="#132B3C" BorderBrush="#29516B" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
     <Image Source="Assets/SahandNama.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock x:Name="WallpaperTitleText" Text="سهند نما • والپیپر فعال روز" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
     <TextBlock x:Name="WallpaperCreditText" Text="منظره هوشمند ویندوز" FontSize="10" Foreground="#7AA2B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
    </StackPanel>
   </Grid>

   <!-- Quick Actions Footer -->
   <Grid Grid.Row="2">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="تصویر بعدی ⏭" Click="NextWallpaper_Click" ToolTip="دریافت و اعمال تصویر بعدی (Win+Alt+W)"/>
     <Button Content="علاقه‌مندی ❤️" Click="Favorite_Click" ToolTip="افزودن به علاقه‌مندی‌ها (Win+Alt+S)"/>
     <Button Content="سهند نما ⚙" Click="OpenApp_Click" ToolTip="باز کردن پنجره اصلی برنامه"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
